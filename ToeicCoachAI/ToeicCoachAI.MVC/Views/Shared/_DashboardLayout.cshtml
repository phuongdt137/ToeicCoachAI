@{
    var activeNav = ViewData["ActiveNav"] as string ?? "Home";
    var userFullName = User.Identity?.Name ?? "Học viên";
    var nameParts = userFullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var initials = nameParts.Length >= 2
        ? $"{char.ToUpperInvariant(nameParts[0][0])}{char.ToUpperInvariant(nameParts[^1][0])}"
        : (userFullName.Length >= 2 ? userFullName[..2].ToUpperInvariant() : "TC");
    var creditBalance = User.FindFirst("CreditBalance")?.Value ?? "10";
    var userTier = User.FindFirst("CurrentTier")?.Value ?? User.FindFirst("Tier")?.Value ?? "FREE";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TOEIC Coach AI</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
</head>
<body class="tc-dashboard-body">
    <div class="tc-db-wrapper">
        <!-- Left Sidebar -->
        <aside class="tc-db-sidebar" id="tcSidebar">
            <a asp-controller="Dashboard" asp-action="Index" class="tc-db-brand">
                <img src="~/images/logo-icon.png" alt="TOEIC Coach AI" />
                <div>
                    <span class="tc-db-brand-title">TOEIC Coach</span>
                    <span class="tc-db-brand-sub">AI 3-Skills Adaptive</span>
                </div>
            </a>

            <ul class="tc-db-nav">
                <li>
                    <a asp-controller="Dashboard" asp-action="Index"
                       class="tc-db-nav-link @(activeNav == "Home" ? "active" : "")">
                        <i class="bi bi-house-door"></i>
                        <span>Trang chủ</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="Dashboard" asp-action="Practice"
                       class="tc-db-nav-link @(activeNav == "Practice" ? "active" : "")">
                        <i class="bi bi-journal-code"></i>
                        <span>Luyện tập</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="Dashboard" asp-action="Tests"
                       class="tc-db-nav-link @(activeNav == "Tests" ? "active" : "")">
                        <i class="bi bi-clipboard2-check"></i>
                        <span>Bài kiểm tra</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="Dashboard" asp-action="Vocabulary"
                       class="tc-db-nav-link @(activeNav == "Vocabulary" ? "active" : "")">
                        <i class="bi bi-book"></i>
                        <span>Từ vựng &amp; Sổ tay lỗi</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="Dashboard" asp-action="Progress"
                       class="tc-db-nav-link @(activeNav == "Progress" ? "active" : "")">
                        <i class="bi bi-graph-up-arrow"></i>
                        <span>Tiến độ &amp; Báo cáo AI</span>
                    </a>
                </li>
            </ul>

            <div class="tc-db-sidebar-divider"></div>

            <ul class="tc-db-nav mb-3">
                <li>
                    <a asp-controller="Dashboard" asp-action="Subscription"
                       class="tc-db-nav-link @(activeNav == "Subscription" ? "active" : "")">
                        <i class="bi bi-wallet2"></i>
                        <span>Ví Credit &amp; Gói cước</span>
                    </a>
                </li>
                @if (User.IsInRole("ADMIN") || User.IsInRole("SYSTEM_ADMIN"))
                {
                    <li>
                        <a href="/hangfire" class="tc-db-nav-link">
                            <i class="bi bi-cpu"></i>
                            <span>Quản trị AI Pipeline</span>
                        </a>
                    </li>
                }
            </ul>

            <!-- Bottom Sidebar Box: Differentiated by UserTier (FREE vs PAID) -->
            @if (userTier == "PAID")
            {
                <div class="tc-db-upgrade-box" style="background: linear-gradient(145deg, #FEFCE8 0%, #FEF3C7 100%); border-color: #FDE68A;">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="badge rounded-pill fw-bold" style="background: #F59E0B; color: #fff; font-size: 0.7rem;">
                            <i class="bi bi-award-fill me-1"></i>PRO COACHING
                        </span>
                        <span class="small fw-bold" style="color: #92400E; font-size: 0.72rem;">Đang kích hoạt</span>
                    </div>
                    <div class="fw-bold small mb-1" style="color: #78350F;">Đặc quyền Học viên Trả phí</div>
                    <div class="text-muted mb-2" style="font-size: 0.75rem; color: #78350F !important; line-height: 1.4;">
                        <i class="bi bi-check2-circle me-1"></i>Mở khóa Full Mock Test, AI Writing &amp; Lộ trình cá nhân hóa.
                    </div>
                    <a asp-controller="Dashboard" asp-action="Subscription" class="tc-db-btn-outline w-100 py-1" style="font-size: 0.8rem; border-color: #F59E0B; color: #92400E;">
                        Quản lý gói &amp; Ví Credit
                    </a>
                </div>
            }
            else
            {
                <div class="tc-db-upgrade-box">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="tc-db-upgrade-icon">
                            <i class="bi bi-stars"></i>
                        </span>
                        <div class="fw-bold small" style="color: #1E293B; line-height: 1.25;">
                            Mở khóa toàn bộ lộ trình
                        </div>
                    </div>
                    <p class="text-muted mb-3" style="font-size: 0.78rem; line-height: 1.45;">
                        Học không giới hạn, chấm bài Writing AI &amp; chạm mốc mục tiêu nhanh hơn.
                    </p>
                    <a asp-controller="Dashboard" asp-action="Subscription" class="tc-db-btn-primary w-100">
                        Nâng cấp
                    </a>
                </div>
            }
        </aside>

        <!-- Main Workspace -->
        <div class="tc-db-main">
            <!-- Sticky Topbar -->
            <header class="tc-db-topbar">
                <div class="d-flex align-items-center gap-2 flex-grow-1">
                    <button class="btn btn-sm btn-light d-lg-none border" type="button" onclick="document.getElementById('tcSidebar').classList.toggle('show')">
                        <i class="bi bi-list fs-5"></i>
                    </button>
                    <div class="tc-db-search">
                        <i class="bi bi-search"></i>
                        <input type="text" placeholder="Tìm bài học, chủ đề..." />
                    </div>
                </div>

                <div class="tc-db-topbar-actions">
                    <span class="tc-db-pill-streak" title="Chuỗi ngày học liên tiếp">
                        <i class="bi bi-fire text-warning"></i> 7 ngày
                    </span>

                    <a asp-controller="Dashboard" asp-action="Subscription" class="tc-db-pill-credit" title="Ví AI Credits & Gói cước (UC-12, UC-13)">
                        <i class="bi bi-lightning-charge-fill text-warning"></i>
                        <span>@creditBalance Credits</span>
                        <span class="badge rounded-pill @(userTier == "PAID" ? "bg-warning text-dark" : "bg-secondary") ms-1" style="font-size: 0.65rem;">
                            @(userTier == "PAID" ? "PRO" : "FREE")
                        </span>
                    </a>

                    <button type="button" class="tc-db-icon-btn" title="Thông báo từ AI Coach">
                        <i class="bi bi-bell"></i>
                    </button>

                    <div class="dropdown">
                        <button class="btn btn-link text-decoration-none p-0 d-flex align-items-center gap-2 text-dark fw-semibold"
                                type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="tc-db-avatar">@initials</span>
                            <span class="d-none d-md-inline" style="font-size: 0.9rem;">@userFullName</span>
                            <i class="bi bi-chevron-down small text-muted"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-4 p-2 mt-2" style="min-width: 230px;">
                            <li class="px-3 py-2 border-bottom mb-1">
                                <div class="fw-bold text-dark small">@userFullName</div>
                                <div class="text-muted" style="font-size: 0.75rem;">@User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value</div>
                            </li>
                            <li>
                                <a class="dropdown-item rounded-3 py-2 small fw-medium" asp-controller="Dashboard" asp-action="Subscription">
                                    <i class="bi bi-wallet2 me-2 text-primary"></i>Ví AI Credits &amp; Gói cước
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item rounded-3 py-2 small fw-medium" asp-controller="Dashboard" asp-action="Progress">
                                    <i class="bi bi-robot me-2 text-primary"></i>Báo cáo Năng lực AI
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item rounded-3 py-2 small fw-medium" asp-controller="Dashboard" asp-action="Vocabulary">
                                    <i class="bi bi-journal-x me-2 text-danger"></i>Sổ tay lỗi sai (Mistakes)
                                </a>
                            </li>
                            <li><hr class="dropdown-divider my-1" /></li>
                            <li>
                                <form asp-controller="Auth" asp-action="Logout" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item rounded-3 py-2 small fw-semibold text-danger">
                                        <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            @if (TempData["SyncedGuestMessage"] is string syncedMsg)
            {
                <div class="px-4 pt-2">
                    <div class="alert alert-success border-0 shadow-sm rounded-4 d-flex align-items-center justify-content-between py-2 px-3 mb-2">
                        <div class="d-flex align-items-center gap-2 small fw-semibold">
                            <i class="bi bi-check-circle-fill text-success fs-5"></i>
                            <span>@syncedMsg</span>
                        </div>
                        <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert"></button>
                    </div>
                </div>
            }

            <!-- Main Page Body -->
            <main class="tc-db-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
