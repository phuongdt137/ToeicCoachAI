@{
    var activeNav = ViewData["ActiveNav"] as string ?? "Overview";
    var userFullName = User.Identity?.Name ?? "System Administrator";
    var nameParts = userFullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var initials = nameParts.Length >= 2
        ? $"{char.ToUpperInvariant(nameParts[0][0])}{char.ToUpperInvariant(nameParts[^1][0])}"
        : "AD";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản trị Hệ thống TOEIC Coach AI</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
</head>
<body class="tc-dashboard-body">
    <div class="tc-db-wrapper">
        <!-- Left Sidebar (Admin Console) -->
        <aside class="tc-db-sidebar" id="tcAdminSidebar">
            <a asp-controller="Admin" asp-action="Index" class="tc-db-brand">
                <img src="~/images/logo-icon.png" alt="TOEIC Coach AI Admin" />
                <div>
                    <span class="tc-db-brand-title">TOEIC Coach</span>
                    <span class="tc-db-brand-sub" style="color: #D97706;">SYSTEM ADMIN</span>
                </div>
            </a>

            <div class="px-2 mb-1 text-uppercase fw-bold text-muted" style="font-size: 0.68rem; letter-spacing: 0.06em;">
                Kho đề &amp; AI Pipeline
            </div>
            <ul class="tc-db-nav">
                <li>
                    <a asp-controller="Admin" asp-action="Index"
                       class="tc-db-nav-link @(activeNav == "Overview" ? "active" : "")">
                        <i class="bi bi-speedometer2"></i>
                        <span>Tổng quan Kho đề</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="Admin" asp-action="SkillTags"
                       class="tc-db-nav-link @(activeNav == "SkillTags" ? "active" : "")">
                        <i class="bi bi-tags"></i>
                        <span>Nhãn Kỹ năng &amp; Luật AI</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="Admin" asp-action="AiPipeline"
                       class="tc-db-nav-link @(activeNav == "AiPipeline" ? "active" : "")">
                        <i class="bi bi-robot"></i>
                        <span>AI Tạo &amp; Kiểm định đề</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="Admin" asp-action="Quarantine"
                       class="tc-db-nav-link @(activeNav == "Quarantine" ? "active" : "")">
                        <i class="bi bi-shield-exclamation"></i>
                        <span>Khu cách ly (Quarantine)</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="Admin" asp-action="QuestionBank"
                       class="tc-db-nav-link @(activeNav == "QuestionBank" ? "active" : "")">
                        <i class="bi bi-collection"></i>
                        <span>Ngân hàng Câu hỏi</span>
                    </a>
                </li>
            </ul>

            <div class="tc-db-sidebar-divider"></div>

            <div class="px-2 mb-1 text-uppercase fw-bold text-muted" style="font-size: 0.68rem; letter-spacing: 0.06em;">
                Cấu hình &amp; Vận hành
            </div>
            <ul class="tc-db-nav mb-3">
                <li>
                    <a asp-controller="Admin" asp-action="Blueprints"
                       class="tc-db-nav-link @(activeNav == "Blueprints" ? "active" : "")">
                        <i class="bi bi-journal-bookmark"></i>
                        <span>Khung Đề thi (Blueprints)</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="Admin" asp-action="Settings"
                       class="tc-db-nav-link @(activeNav == "Settings" ? "active" : "")">
                        <i class="bi bi-sliders"></i>
                        <span>Credit &amp; Gói cước</span>
                    </a>
                </li>
                <li>
                    <a href="/hangfire" target="_blank" class="tc-db-nav-link">
                        <i class="bi bi-cpu"></i>
                        <span>Hangfire Cron / Queue</span>
                        <i class="bi bi-box-arrow-up-right ms-auto" style="font-size: 0.75rem;"></i>
                    </a>
                </li>
            </ul>

            <!-- Bottom Status Box -->
            <div class="tc-db-upgrade-box" style="background: linear-gradient(145deg, #EEF2FF 0%, #E0E7FF 100%); border-color: #C7D2FE;">
                <div class="d-flex align-items-center justify-content-between mb-1">
                    <span class="badge rounded-pill bg-primary text-white" style="font-size: 0.68rem;">
                        <i class="bi bi-lightning-charge-fill me-1"></i>DUAL-AI PIPELINE
                    </span>
                    <span class="small fw-bold text-success" style="font-size: 0.72rem;">● Online</span>
                </div>
                <div class="fw-bold small text-dark mb-1">Generator + Blind Validator</div>
                <div class="text-muted" style="font-size: 0.74rem; line-height: 1.4;">
                    OpenAI <code>gpt-4o-mini</code> + Flux Cloud Image + Multi-Voice TTS.
                </div>
            </div>
        </aside>

        <!-- Main Workspace -->
        <div class="tc-db-main">
            <!-- Topbar -->
            <header class="tc-db-topbar">
                <div class="d-flex align-items-center gap-2 flex-grow-1">
                    <button class="btn btn-sm btn-light d-lg-none border" type="button" onclick="document.getElementById('tcAdminSidebar').classList.toggle('show')">
                        <i class="bi bi-list fs-5"></i>
                    </button>
                    <div class="tc-db-search">
                        <i class="bi bi-search"></i>
                        <input type="text" placeholder="Tìm mã SkillTag, câu hỏi, hoặc Job ID..." />
                    </div>
                </div>

                <div class="tc-db-topbar-actions">
                    <span class="badge rounded-pill px-3 py-2 fw-bold border" style="background: #FFFBEB; color: #B45309; border-color: #FDE68A !important;">
                        <i class="bi bi-shield-lock-fill me-1"></i>SYSTEM_ADMIN
                    </span>

                    <div class="dropdown">
                        <button class="btn btn-link text-decoration-none p-0 d-flex align-items-center gap-2 text-dark fw-semibold"
                                type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="tc-db-avatar" style="background: #1E3A8A; color: #fff;">@initials</span>
                            <span class="d-none d-md-inline" style="font-size: 0.9rem;">@userFullName</span>
                            <i class="bi bi-chevron-down small text-muted"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-4 p-2 mt-2" style="min-width: 230px;">
                            <li class="px-3 py-2 border-bottom mb-1">
                                <div class="fw-bold text-dark small">@userFullName</div>
                                <div class="text-muted" style="font-size: 0.75rem;">@User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value</div>
                            </li>
                            <li>
                                <a class="dropdown-item rounded-3 py-2 small fw-medium" asp-controller="Admin" asp-action="SkillTags">
                                    <i class="bi bi-tags me-2 text-primary"></i>Quản lý Nhãn Kỹ năng
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item rounded-3 py-2 small fw-medium" href="/hangfire" target="_blank">
                                    <i class="bi bi-cpu me-2 text-primary"></i>Hangfire Dashboard
                                </a>
                            </li>
                            <li><hr class="dropdown-divider my-1" /></li>
                            <li>
                                <form asp-controller="Auth" asp-action="Logout" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item rounded-3 py-2 small fw-semibold text-danger">
                                        <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            @if (TempData["AdminSuccess"] is string successMsg)
            {
                <div class="px-4 pt-2">
                    <div class="alert alert-success border-0 shadow-sm rounded-4 d-flex align-items-center justify-content-between py-2 px-3 mb-2">
                        <div class="d-flex align-items-center gap-2 small fw-semibold">
                            <i class="bi bi-check-circle-fill text-success fs-5"></i>
                            <span>@successMsg</span>
                        </div>
                        <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert"></button>
                    </div>
                </div>
            }

            @if (TempData["AdminError"] is string errorMsg)
            {
                <div class="px-4 pt-2">
                    <div class="alert alert-danger border-0 shadow-sm rounded-4 d-flex align-items-center justify-content-between py-2 px-3 mb-2">
                        <div class="d-flex align-items-center gap-2 small fw-semibold">
                            <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
                            <span>@errorMsg</span>
                        </div>
                        <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert"></button>
                    </div>
                </div>
            }

            <main class="tc-db-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
