<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ToeicCoachAI</title>
    <link rel="icon" type="image/png" href="~/images/logo-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ToeicCoachAI.MVC.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg tc-navbar">
            <div class="container">
                <a class="tc-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo-icon.png" alt="ToeicCoachAI Logo" class="tc-brand-logo" />
                    <span><span class="tc-brand-toeic">Toeic</span><span class="tc-brand-coach">Coach</span><span class="tc-brand-ai">AI</span></span>
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar" aria-expanded="false" aria-label="Mở menu điều hướng">
                    <i class="bi bi-list fs-2 text-dark"></i>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link tc-nav-link" asp-controller="Home" asp-action="Index" asp-fragment="tinh-nang">Tính năng</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link tc-nav-link" asp-controller="Home" asp-action="Index" asp-fragment="lo-trinh">Lộ trình học</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link tc-nav-link" asp-controller="Home" asp-action="Index" asp-fragment="bang-gia">Bảng giá</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link tc-nav-link" asp-controller="Home" asp-action="Index" asp-fragment="ve-toeiccoachai">Về ToeicCoachAI</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link tc-nav-link" asp-controller="Home" asp-action="Index" asp-fragment="cau-hoi-thuong-gap">Liên hệ</a>
                        </li>
                    </ul>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        var tierClaim = User.FindFirst("Tier")?.Value ?? "FREE";
                        var creditClaim = User.FindFirst("CreditBalance")?.Value ?? "0";
                        var isPaid = string.Equals(tierClaim, "PAID", StringComparison.OrdinalIgnoreCase);

                        <div class="d-flex align-items-center gap-3 mt-3 mt-lg-0">
                            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-tc-primary btn-sm px-3 py-1">
                                <i class="bi bi-grid-1x2-fill me-1"></i>Vào Dashboard
                            </a>

                            <!-- AI Credit Balance Pill -->
                            <div class="d-inline-flex align-items-center gap-1 px-3 py-1 rounded-pill border"
                                 style="background-color: var(--tc-primary-soft); border-color: var(--tc-primary-border) !important; font-size: 0.82rem;">
                                <i class="bi bi-lightning-charge-fill text-warning"></i>
                                <span class="fw-bold text-tc-primary">@creditClaim</span>
                                <span class="text-secondary">Credits</span>
                            </div>

                            <!-- User Profile & Logout Dropdown -->
                            <div class="dropdown">
                                <button class="btn btn-sm d-flex align-items-center gap-2 px-2 py-1 border rounded-3 bg-white dropdown-toggle"
                                        type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span class="tc-icon-badge tc-icon-badge-blue" style="width: 28px; height: 28px; font-size: 0.8rem;">
                                        <i class="bi bi-person-fill"></i>
                                    </span>
                                    <span class="fw-semibold text-dark" style="font-size: 0.88rem;">@User.Identity.Name</span>
                                    <span class="badge @(isPaid ? "bg-warning text-dark" : "bg-secondary")" style="font-size: 0.68rem;">
                                        @tierClaim
                                    </span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2" style="font-size: 0.88rem;">
                                    <li class="px-3 py-2 border-bottom">
                                        <div class="fw-bold text-dark">@User.Identity.Name</div>
                                        <div class="text-muted" style="font-size: 0.78rem;">@User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value</div>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Dashboard" asp-action="Index">
                                            <i class="bi bi-grid-1x2 me-2 text-tc-primary"></i>Bảng điều khiển (Dashboard)
                                        </a>
                                    </li>
                                    @if (User.IsInRole("SYSTEM_ADMIN") || User.IsInRole("ADMIN"))
                                    {
                                        <li>
                                            <a class="dropdown-item py-2" href="/hangfire">
                                                <i class="bi bi-gear-wide-connected me-2 text-tc-primary"></i>Quản trị AI Pipeline (Hangfire)
                                            </a>
                                        </li>
                                    }
                                    <li>
                                        <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item py-2 text-danger fw-medium">
                                                <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex align-items-center gap-2 mt-3 mt-lg-0">
                            <a asp-controller="Auth" asp-action="Login" class="btn btn-tc-outline btn-sm px-3 py-2">Đăng nhập</a>
                            <a asp-controller="Auth" asp-action="Register" class="btn btn-tc-primary btn-sm px-3 py-2">Đăng ký miễn phí</a>
                        </div>
                    }
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="tc-footer">
        <div class="container">
            <div class="row gy-4">
                <div class="col-lg-4 pe-lg-5">
                    <a class="tc-brand text-white mb-3" asp-area="" asp-controller="Home" asp-action="Index">
                        <img src="~/images/logo-icon.png" alt="ToeicCoachAI Logo" class="tc-brand-logo" />
                        <div class="d-flex flex-column lh-1">
                            <span class="fs-5 fw-bold"><span class="text-white">Toeic</span><span class="tc-brand-coach">Coach</span><span class="tc-brand-ai">AI</span></span>
                            <span class="text-uppercase text-secondary" style="font-size: 0.62rem; letter-spacing: 0.12em; margin-top: 4px;">AI TOEIC COACH</span>
                        </div>
                    </a>
                    <p class="mb-3 text-secondary" style="color: #94a3b8 !important; font-size: 0.88rem;">
                        Nền tảng luyện thi TOEIC 3 kỹ năng (Listening - Reading - Writing) bằng AI dành cho sinh viên và người đi làm Việt Nam: chẩn đoán trình độ, lộ trình cá nhân hóa và giải thích từng lỗi sai.
                    </p>
                    <a href="mailto:hotro@toeiccoach.ai" class="text-white text-decoration-none fw-medium" style="font-size: 0.88rem;">
                        hotro@toeiccoach.ai
                    </a>
                </div>

                <div class="col-6 col-md-3 col-lg-2">
                    <h6 class="tc-footer-heading">Sản phẩm</h6>
                    <ul class="tc-footer-links">
                        <li><a asp-controller="Home" asp-action="Index" asp-fragment="tinh-nang">Tính năng</a></li>
                        <li><a asp-controller="Home" asp-action="Index" asp-fragment="lo-trinh">Lộ trình học</a></li>
                        <li><a asp-controller="Home" asp-action="Index" asp-fragment="bang-gia">Bảng giá</a></li>
                        <li><a asp-controller="Home" asp-action="Index" asp-fragment="kiem-tra-trinh-do">Kiểm tra trình độ</a></li>
                    </ul>
                </div>

                <div class="col-6 col-md-3 col-lg-2">
                    <h6 class="tc-footer-heading">Công ty</h6>
                    <ul class="tc-footer-links">
                        <li><a asp-controller="Home" asp-action="Index" asp-fragment="ve-toeiccoachai">Về ToeicCoachAI</a></li>
                        <li><a asp-controller="Home" asp-action="Index" asp-fragment="cau-hoi-thuong-gap">Liên hệ</a></li>
                        <li><a href="#hop-tac">Hợp tác trường học</a></li>
                    </ul>
                </div>

                <div class="col-6 col-md-3 col-lg-2">
                    <h6 class="tc-footer-heading">Hỗ trợ</h6>
                    <ul class="tc-footer-links">
                        <li><a asp-controller="Home" asp-action="Index" asp-fragment="cau-hoi-thuong-gap">Câu hỏi thường gặp</a></li>
                        <li><a asp-controller="Auth" asp-action="Login">Đăng nhập</a></li>
                        <li><a asp-controller="Auth" asp-action="Register">Đăng ký</a></li>
                    </ul>
                </div>

                <div class="col-6 col-md-3 col-lg-2">
                    <h6 class="tc-footer-heading">Pháp lý</h6>
                    <ul class="tc-footer-links">
                        <li><a href="#dieu-khoan">Điều khoản sử dụng</a></li>
                        <li><a href="#bao-mat">Chính sách bảo mật</a></li>
                    </ul>
                </div>
            </div>

            <div class="tc-footer-bottom d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
                <div>&copy; 2026 ToeicCoachAI – AI TOEIC Coach. Bảo lưu mọi quyền.</div>
                <div>Dành cho sinh viên Việt Nam.</div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
