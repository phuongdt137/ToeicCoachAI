@model ToeicCoachAI.Model.DTOs.Admin.QuarantinePageDto
@using ToeicCoachAI.Model.Enums
@{
    ViewData["Title"] = "Khu cách ly Câu hỏi (Quarantine Queue)";
    ViewData["ActiveNav"] = "Quarantine";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- Header -->
<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge rounded-pill px-3 py-1 fw-bold" style="background: #FFFBEB; color: #B45309; border: 1px solid #FDE68A;">
                <i class="bi bi-shield-exclamation me-1"></i>UC-19: QUARANTINE REVIEW QUEUE
            </span>
            <span class="badge rounded-pill bg-danger-subtle text-danger fw-bold px-3 py-1">
                @Model.QuarantinedGroups.Count cụm đề đang chờ duyệt
            </span>
        </div>
        <h3 class="fw-extrabold mb-1" style="font-family: 'Plus Jakarta Sans', sans-serif; color: #0F172A;">
            Khu cách ly &amp; Hậu kiểm Câu hỏi AI (Quarantine)
        </h3>
        <p class="text-muted small mb-0">
            Các cụm câu hỏi bị <strong>Blind Validator AI</strong> phát hiện bất đồng đáp án hoặc điểm ETS Compliance &lt; 80%. Admin có thể nghe thử Audio, xem tranh AI, sửa trực tiếp đáp án và bấm <strong>Duyệt &amp; Xuất bản</strong>.
        </p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a asp-controller="Admin" asp-action="AiPipeline" class="btn btn-primary rounded-pill px-3 fw-semibold small">
            <i class="bi bi-robot me-1"></i>Sinh thêm đề bằng AI
        </a>
        <a asp-controller="Admin" asp-action="QuestionBank" class="btn btn-outline-secondary rounded-pill px-3 fw-semibold small">
            <i class="bi bi-collection me-1"></i>Ngân hàng Câu hỏi
        </a>
    </div>
</div>

@if (!Model.QuarantinedGroups.Any())
{
    <div class="tc-db-panel p-5 text-center">
        <div class="mb-3">
            <span class="d-inline-flex align-items-center justify-content-center rounded-circle" style="width: 64px; height: 64px; background: #ECFDF5; color: #059669;">
                <i class="bi bi-shield-check fs-2"></i>
            </span>
        </div>
        <h5 class="fw-bold text-dark">Khu cách ly hiện đang trống!</h5>
        <p class="text-muted small mb-3">
            Tất cả câu hỏi do AI sinh ra đều đã vượt qua bài kiểm định mù (Blind Validation) hoặc đã được Admin xử lý xong.
        </p>
        <a asp-controller="Admin" asp-action="AiPipeline" class="btn btn-primary rounded-pill px-4 fw-semibold">
            <i class="bi bi-lightning-charge-fill me-1"></i>Chạy Pipeline AI Sinh đề mới
        </a>
    </div>
}
else
{
    <div class="d-flex flex-column gap-4">
        @foreach (var group in Model.QuarantinedGroups)
        {
            <div class="tc-db-panel p-4 border-start border-4 border-warning">
                <!-- Top Metadata Bar -->
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 pb-3 mb-3 border-bottom">
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <span class="badge bg-warning text-dark fw-bold rounded-pill px-3 py-1">
                            <i class="bi bi-exclamation-octagon-fill me-1"></i>QUARANTINED
                        </span>
                        <span class="badge bg-primary-subtle text-primary fw-bold">@group.SkillType — Part @group.PartNumber</span>
                        <span class="badge bg-light text-dark border fw-semibold">@group.SkillTagCode — @group.SkillTagName</span>
                        <span class="badge bg-secondary-subtle text-secondary">Độ khó: Level @group.DifficultyLevel</span>
                        <span class="text-muted small">
                            <i class="bi bi-clock me-1"></i>@group.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                        </span>
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        <form asp-controller="Admin" asp-action="ChangeGroupStatus" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="groupId" value="@group.GroupId" />
                            <input type="hidden" name="status" value="@QuestionGroupStatus.ARCHIVED" />
                            <input type="hidden" name="returnAction" value="Quarantine" />
                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-semibold"
                                    onclick="return confirm('Bạn có chắc muốn lưu trữ (Archive/Loại bỏ) cụm câu hỏi này?');">
                                <i class="bi bi-archive me-1"></i>Loại bỏ (Archive)
                            </button>
                        </form>
                    </div>
                </div>

                <!-- Blind Validator Critique Banner -->
                <div class="alert alert-warning border-0 rounded-3 p-3 mb-3">
                    <div class="d-flex align-items-start gap-3">
                        <i class="bi bi-robot fs-4 text-warning-emphasis"></i>
                        <div class="flex-grow-1">
                            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-1">
                                <span class="fw-bold text-dark small">
                                    Biên bản Kiểm định Mù (Blind Validator Critique):
                                </span>
                                @if (group.LatestValidation != null)
                                {
                                    <div class="d-flex gap-2">
                                        <span class="badge bg-danger rounded-pill">
                                            ETS Score: @group.LatestValidation.EtsComplianceScore%
                                        </span>
                                        <span class="badge bg-dark rounded-pill">
                                            Distractor: @group.LatestValidation.DistractorQualityScore%
                                        </span>
                                    </div>
                                }
                            </div>
                            <div class="small text-dark">
                                @(string.IsNullOrWhiteSpace(group.LatestValidation?.RejectionReasons)
                                    ? "Validator AI phát hiện có phương án gây nhiễu chưa rõ ràng hoặc bất đồng đáp án giữa Generator và Blind Solver."
                                    : group.LatestValidation.RejectionReasons)
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Media Assets Preview (Cloud Image + Cloud Audio / Web Speech TTS) -->
                @if (!string.IsNullOrWhiteSpace(group.ImageUrl) || !string.IsNullOrWhiteSpace(group.AudioUrl) || !string.IsNullOrWhiteSpace(group.TranscriptData))
                {
                    <div class="row g-3 mb-3 p-3 rounded-3" style="background: #F8FAFC; border: 1px solid #E2E8F0;">
                        @if (!string.IsNullOrWhiteSpace(group.ImageUrl))
                        {
                            <div class="col-md-5">
                                <div class="fw-bold small text-dark mb-2">
                                    <i class="bi bi-image text-primary me-1"></i>Tranh AI (@(group.StorageProvider ?? "Flux Cloud CDN") - 0 Bytes Local):
                                </div>
                                <img src="@group.ImageUrl" alt="TOEIC AI Generated Scene"
                                     class="img-fluid rounded-3 border shadow-sm"
                                     style="max-height: 220px; object-fit: cover; width: 100%;" />
                                @if (!string.IsNullOrWhiteSpace(group.ImagePrompt))
                                {
                                    <div class="text-muted mt-1" style="font-size: 0.72rem;">
                                        <strong>Image Prompt:</strong> @group.ImagePrompt
                                    </div>
                                }
                            </div>
                        }
                        <div class="@(!string.IsNullOrWhiteSpace(group.ImageUrl) ? "col-md-7" : "col-12")">
                            @if (!string.IsNullOrWhiteSpace(group.AudioUrl))
                            {
                                <div class="fw-bold small text-dark mb-2">
                                    <i class="bi bi-volume-up-fill text-primary me-1"></i>Audio Listening (Cloud TTS Stream):
                                </div>
                                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                    <audio controls preload="none" class="flex-grow-1" style="height: 36px;">
                                        <source src="@group.AudioUrl" type="audio/mpeg" />
                                    </audio>
                                    <button type="button" class="btn btn-sm btn-outline-primary rounded-pill"
                                            onclick="speakToeicTranscript(this)"
                                            data-transcript="@(group.TranscriptData ?? group.PassageContent)">
                                        <i class="bi bi-soundwave me-1"></i>Đọc thử giọng chuẩn
                                    </button>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(group.TranscriptData))
                            {
                                <div class="fw-bold small text-secondary mb-1">Audio Transcript:</div>
                                <div class="p-2 rounded bg-white border small text-dark" style="white-space: pre-line;">@group.TranscriptData</div>
                            }
                        </div>
                    </div>
                }

                <!-- Editable Form to Fix & Publish Directly -->
                <form asp-controller="Admin" asp-action="ApproveQuarantine" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="GroupId" value="@group.GroupId" />

                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-dark">Đoạn văn / Ngữ cảnh gốc (PassageContent):</label>
                            <textarea name="PassageContent" class="form-control form-control-sm rounded-3" rows="2">@group.PassageContent</textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-dark">Lời thoại Audio (TranscriptData):</label>
                            <textarea name="TranscriptData" class="form-control form-control-sm rounded-3" rows="2">@group.TranscriptData</textarea>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(group.ImagePrompt))
                    {
                        <div class="row g-2 align-items-center mb-3">
                            <div class="col-md-8">
                                <label class="form-label small fw-bold text-dark mb-1">Image Prompt (Flux AI):</label>
                                <input type="text" name="ImagePrompt" class="form-control form-control-sm rounded-3" value="@group.ImagePrompt" />
                            </div>
                            <div class="col-md-4 pt-3">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" name="RegenerateCloudImage" value="true" id="regenImg_@group.GroupId" />
                                    <label class="form-check-label small fw-semibold" for="regenImg_@group.GroupId">Vẽ lại ảnh Cloud mới khi duyệt</label>
                                </div>
                            </div>
                        </div>
                    }

                    @if (group.Questions.Any())
                    {
                        var firstItem = group.Questions.First();
                        <input type="hidden" name="QuestionId" value="@firstItem.QuestionId" />

                        <div class="p-3 rounded-3 mb-3" style="background: #EFF6FF; border: 1px solid #BFDBFE;">
                            <div class="fw-bold small text-primary mb-2">
                                <i class="bi bi-pencil-square me-1"></i>Chỉnh sửa nhanh Câu hỏi #1 (Hoặc đối chiếu đáp án với Blind Validator):
                            </div>

                            <div class="mb-2">
                                <label class="form-label small fw-semibold mb-1">Nội dung câu hỏi (Question Stem):</label>
                                <input type="text" name="QuestionStem" class="form-control form-control-sm rounded-3" value="@firstItem.QuestionStem" />
                            </div>

                            <div class="row g-2 mb-2">
                                <div class="col-md-6">
                                    <label class="form-label small fw-semibold mb-1">Phương án A:</label>
                                    <input type="text" name="OptionA" class="form-control form-control-sm rounded-3" value="@firstItem.OptionA" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-semibold mb-1">Phương án B:</label>
                                    <input type="text" name="OptionB" class="form-control form-control-sm rounded-3" value="@firstItem.OptionB" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-semibold mb-1">Phương án C:</label>
                                    <input type="text" name="OptionC" class="form-control form-control-sm rounded-3" value="@firstItem.OptionC" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-semibold mb-1">Phương án D:</label>
                                    <input type="text" name="OptionD" class="form-control form-control-sm rounded-3" value="@firstItem.OptionD" />
                                </div>
                            </div>

                            <div class="row g-2 align-items-center">
                                <div class="col-md-3">
                                    <label class="form-label small fw-bold text-success mb-1">Đáp án đúng chốt hạ:</label>
                                    <select name="CorrectOption" class="form-select form-select-sm rounded-3 fw-bold border-success">
                                        @foreach (var opt in new[] { 'A', 'B', 'C', 'D' })
                                        {
                                            <option value="@opt" selected="@(firstItem.CorrectOption == opt)">Đáp án @opt</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-9">
                                    <label class="form-label small fw-semibold mb-1">Lời giải chi tiết (ExplanationGeneral):</label>
                                    <input type="text" name="ExplanationGeneral" class="form-control form-control-sm rounded-3" value="@firstItem.ExplanationGeneral" />
                                </div>
                            </div>
                        </div>
                    }

                    <div class="d-flex justify-content-end gap-2">
                        <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold shadow-sm">
                            <i class="bi bi-check2-circle me-1"></i>Chốt đáp án &amp; Xuất bản vào Ngân hàng Đề (PUBLISH)
                        </button>
                    </div>
                </form>
            </div>
        }
    </div>
}

@section Scripts {
    <script>
        function speakToeicTranscript(btn) {
            const text = btn.getAttribute('data-transcript');
            if (!text || !('speechSynthesis' in window)) {
                alert('Trình duyệt không hỗ trợ đọc giọng nói trực tiếp.');
                return;
            }
            window.speechSynthesis.cancel();
            const utter = new SpeechSynthesisUtterance(text);
            utter.lang = 'en-US';
            utter.rate = 0.96;
            window.speechSynthesis.speak(utter);
        }
    </script>
}
