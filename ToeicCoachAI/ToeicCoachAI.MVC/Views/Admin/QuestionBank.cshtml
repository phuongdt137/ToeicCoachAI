@model ToeicCoachAI.Model.DTOs.Admin.QuestionBankPageDto
@using ToeicCoachAI.Model.Enums
@{
    ViewData["Title"] = "Ngân hàng Câu hỏi TOEIC 4 Kỹ năng";
    ViewData["ActiveNav"] = "QuestionBank";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- Header -->
<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge rounded-pill px-3 py-1 fw-bold" style="background: #EFF6FF; color: #1D4ED8; border: 1px solid #BFDBFE;">
                <i class="bi bi-collection-fill me-1"></i>UC-20: QUESTION BANK EXPLORER
            </span>
            <span class="badge rounded-pill bg-success-subtle text-success fw-bold px-3 py-1">
                Tổng cộng @Model.Groups.Count cụm câu hỏi trong kho
            </span>
        </div>
        <h3 class="fw-extrabold mb-1" style="font-family: 'Plus Jakarta Sans', sans-serif; color: #0F172A;">
            Ngân hàng Câu hỏi TOEIC Đa phương tiện (Question Bank)
        </h3>
        <p class="text-muted small mb-0">
            Quản lý toàn bộ câu hỏi <code>PUBLISHED</code>, <code>QUARANTINED</code>, <code>ARCHIVED</code> từ cả nguồn AI sinh tự động (<code>AI_GENERATED</code>) và Admin biên soạn chuẩn (<code>CURATED_STANDARD</code>).
        </p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <button type="button" class="btn btn-outline-primary rounded-pill px-3 fw-semibold small"
                data-bs-toggle="modal" data-bs-target="#createCuratedModal">
            <i class="bi bi-plus-circle-fill me-1"></i>Tạo Câu hỏi Chuẩn (CURATED)
        </button>
        <a asp-controller="Admin" asp-action="AiPipeline" class="btn btn-primary rounded-pill px-3 fw-semibold small">
            <i class="bi bi-robot me-1"></i>AI Sinh đề Tự động
        </a>
    </div>
</div>

<!-- Client-side Instant Filter Bar -->
<div class="tc-db-panel p-3 mb-4">
    <div class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label small fw-bold text-muted mb-1">Lọc theo Trạng thái</label>
            <select id="qbFilterStatus" class="form-select form-select-sm rounded-3" onchange="filterQuestionBankCards()">
                <option value="">-- Mọi trạng thái --</option>
                <option value="PUBLISHED">PUBLISHED (Đang mở thi)</option>
                <option value="QUARANTINED">QUARANTINED (Đang cách ly)</option>
                <option value="ARCHIVED">ARCHIVED (Đã lưu trữ)</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small fw-bold text-muted mb-1">Lọc theo Kỹ năng</label>
            <select id="qbFilterSkill" class="form-select form-select-sm rounded-3" onchange="filterQuestionBankCards()">
                <option value="">-- Tất cả kỹ năng --</option>
                <option value="LISTENING">LISTENING</option>
                <option value="READING">READING</option>
                <option value="SPEAKING">SPEAKING</option>
                <option value="WRITING">WRITING</option>
            </select>
        </div>
        <div class="col-md-6">
            <label class="form-label small fw-bold text-muted mb-1">Tìm kiếm nhanh</label>
            <input type="text" id="qbSearchInput" class="form-control form-control-sm rounded-3"
                   placeholder="Nhập mã SkillTag, Part, hoặc nội dung câu hỏi..." oninput="filterQuestionBankCards()" />
        </div>
    </div>
</div>

<!-- Question Groups List -->
@if (!Model.Groups.Any())
{
    <div class="tc-db-panel p-5 text-center">
        <i class="bi bi-inbox fs-1 text-muted mb-2 d-block"></i>
        <h5 class="fw-bold text-dark">Chưa có cụm câu hỏi nào trong Ngân hàng Đề</h5>
        <p class="text-muted small mb-3">Hãy chạy Pipeline AI hoặc biên soạn câu hỏi chuẩn để bổ sung đề mới vào kho.</p>
        <a asp-controller="Admin" asp-action="AiPipeline" class="btn btn-primary rounded-pill px-4 fw-semibold">
            <i class="bi bi-lightning-charge-fill me-1"></i>Mở AI Pipeline Sinh đề
        </a>
    </div>
}
else
{
    <div class="d-flex flex-column gap-3" id="qbGroupsContainer">
        @foreach (var group in Model.Groups)
        {
            <div class="tc-db-panel p-4 qb-group-card"
                 data-status="@group.Status"
                 data-skill="@group.SkillType"
                 data-search="@($"{group.SkillTagCode} {group.SkillTagName} Part {group.PartNumber} {group.PassageContent} {string.Join(" ", group.Questions.Select(q => q.QuestionStem))}").ToLowerInvariant()">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 pb-2 mb-3 border-bottom">
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        @if (group.Status == QuestionGroupStatus.PUBLISHED)
                        {
                            <span class="badge bg-success text-white rounded-pill px-3 py-1">PUBLISHED</span>
                        }
                        else if (group.Status == QuestionGroupStatus.QUARANTINED)
                        {
                            <span class="badge bg-warning text-dark rounded-pill px-3 py-1">QUARANTINED</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary text-white rounded-pill px-3 py-1">@group.Status</span>
                        }

                        <span class="badge @(group.SourceType == QuestionSourceType.CURATED_STANDARD ? "bg-dark text-white" : "bg-primary-subtle text-primary") rounded-pill">
                            @group.SourceType
                        </span>
                        <span class="badge bg-light text-dark border fw-bold">@group.SkillType — Part @group.PartNumber</span>
                        <span class="fw-bold small text-primary">@group.SkillTagCode — @group.SkillTagName</span>
                        <span class="badge bg-info-subtle text-info-emphasis">Level @group.DifficultyLevel</span>
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        @if (group.Status != QuestionGroupStatus.PUBLISHED)
                        {
                            <form asp-controller="Admin" asp-action="ChangeGroupStatus" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="groupId" value="@group.GroupId" />
                                <input type="hidden" name="status" value="@QuestionGroupStatus.PUBLISHED" />
                                <input type="hidden" name="returnAction" value="QuestionBank" />
                                <button type="submit" class="btn btn-sm btn-outline-success rounded-pill px-3 fw-semibold">
                                    <i class="bi bi-check2-circle me-1"></i>Xuất bản (Publish)
                                </button>
                            </form>
                        }
                        @if (group.Status != QuestionGroupStatus.ARCHIVED)
                        {
                            <form asp-controller="Admin" asp-action="ChangeGroupStatus" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="groupId" value="@group.GroupId" />
                                <input type="hidden" name="status" value="@QuestionGroupStatus.ARCHIVED" />
                                <input type="hidden" name="returnAction" value="QuestionBank" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                                    <i class="bi bi-archive me-1"></i>Archive
                                </button>
                            </form>
                        }
                    </div>
                </div>

                <!-- Media + Passage Row -->
                <div class="row g-3 mb-3">
                    @if (!string.IsNullOrWhiteSpace(group.ImageUrl))
                    {
                        <div class="col-md-4">
                            <img src="@group.ImageUrl" alt="TOEIC Scene" class="img-fluid rounded-3 border shadow-sm" style="max-height: 185px; width: 100%; object-fit: cover;" />
                            <div class="text-muted mt-1" style="font-size: 0.7rem;">
                                <i class="bi bi-cloud-check text-success me-1"></i>@(group.StorageProvider ?? "Cloud CDN") (0B local)
                            </div>
                        </div>
                    }
                    <div class="@(!string.IsNullOrWhiteSpace(group.ImageUrl) ? "col-md-8" : "col-12")">
                        @if (!string.IsNullOrWhiteSpace(group.AudioUrl))
                        {
                            <div class="d-flex align-items-center gap-2 mb-2 p-2 rounded-3 bg-light border">
                                <i class="bi bi-headphones text-primary fs-5 ms-1"></i>
                                <audio controls preload="none" class="flex-grow-1" style="height: 34px;">
                                    <source src="@group.AudioUrl" type="audio/mpeg" />
                                </audio>
                                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill text-nowrap"
                                        onclick="speakToeicTranscript(this)"
                                        data-transcript="@(group.TranscriptData ?? group.PassageContent)">
                                    <i class="bi bi-soundwave me-1"></i>Đọc giọng chuẩn
                                </button>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(group.PassageContent))
                        {
                            <div class="p-3 rounded-3 bg-light border small text-dark mb-2" style="white-space: pre-line;">@group.PassageContent</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(group.TranscriptData))
                        {
                            <div class="p-2 rounded-3 bg-white border small text-secondary" style="white-space: pre-line;">
                                <strong>Transcript:</strong> @group.TranscriptData
                            </div>
                        }
                    </div>
                </div>

                <!-- Child Question Items -->
                <div class="row g-2">
                    @foreach (var item in group.Questions)
                    {
                        <div class="col-md-@(group.Questions.Count > 1 ? "6" : "12")">
                            <div class="p-3 rounded-3 border bg-white h-100">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="fw-bold small text-dark">Câu #@item.QuestionOrder: @item.QuestionStem</span>
                                    @if (item.CorrectOption.HasValue)
                                    {
                                        <span class="badge bg-success text-white rounded-pill">Đáp án: @item.CorrectOption</span>
                                    }
                                </div>
                                <div class="row g-1 small text-secondary mb-2">
                                    <div class="col-sm-6 @(item.CorrectOption == 'A' ? "fw-bold text-success" : "")">
                                        @(item.OptionA.StartsWith("(A)") ? item.OptionA : $"(A) {item.OptionA}")
                                    </div>
                                    <div class="col-sm-6 @(item.CorrectOption == 'B' ? "fw-bold text-success" : "")">
                                        @(item.OptionB.StartsWith("(B)") ? item.OptionB : $"(B) {item.OptionB}")
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(item.OptionC))
                                    {
                                        <div class="col-sm-6 @(item.CorrectOption == 'C' ? "fw-bold text-success" : "")">
                                            @(item.OptionC.StartsWith("(C)") ? item.OptionC : $"(C) {item.OptionC}")
                                        </div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(item.OptionD))
                                    {
                                        <div class="col-sm-6 @(item.CorrectOption == 'D' ? "fw-bold text-success" : "")">
                                            @(item.OptionD.StartsWith("(D)") ? item.OptionD : $"(D) {item.OptionD}")
                                        </div>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(item.ExplanationGeneral))
                                {
                                    <div class="text-muted pt-2 border-top" style="font-size: 0.75rem;">
                                        <i class="bi bi-lightbulb-fill text-warning me-1"></i><strong>Giải thích:</strong> @item.ExplanationGeneral
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}

<!-- Modal: Create Curated Question Group (UC-20) -->
<div class="modal fade" id="createCuratedModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow">
            <form asp-controller="Admin" asp-action="CreateCuratedQuestion" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header border-bottom-0 pb-0">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-patch-check-fill text-primary me-2"></i>Biên soạn Câu hỏi Chuẩn (CURATED_STANDARD — Xuất bản Ngay)
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Kỹ năng (SkillType)</label>
                            <select name="SkillType" class="form-select form-select-sm rounded-3" required>
                                @foreach (var s in Enum.GetValues<SkillType>())
                                {
                                    <option value="@s" selected="@(s == SkillType.READING)">@s</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Part (1 - 9)</label>
                            <input type="number" name="PartNumber" class="form-control form-control-sm rounded-3" value="5" min="1" max="9" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Độ khó (1 - 3)</label>
                            <select name="DifficultyLevel" class="form-select form-select-sm rounded-3">
                                <option value="1">1 - Foundation (0-450)</option>
                                <option value="2" selected>2 - Intermediate (500-700)</option>
                                <option value="3">3 - Advanced (750-990)</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">Nhãn Kỹ năng (SkillTag) <span class="text-danger">*</span></label>
                        <select name="SkillTagId" class="form-select form-select-sm rounded-3" required>
                            @foreach (var tag in Model.SkillTags)
                            {
                                <option value="@tag.Id">[@tag.Category] @tag.Code - @tag.Name</option>
                            }
                        </select>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Đoạn văn (PassageContent - Để trống nếu câu đơn)</label>
                            <textarea name="PassageContent" class="form-control form-control-sm rounded-3" rows="2"></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Lời thoại Audio (TranscriptData - Tự sinh TTS Cloud)</label>
                            <textarea name="TranscriptData" class="form-control form-control-sm rounded-3" rows="2"></textarea>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">Mô tả Tranh để AI Flux tự vẽ Cloud URL (Tùy chọn cho Part 1 / Writing)</label>
                        <input type="text" name="ImagePrompt" class="form-control form-control-sm rounded-3"
                               placeholder="VD: Two business colleagues reviewing charts on a laptop in a modern conference room..." />
                    </div>

                    <div class="mb-2">
                        <label class="form-label small fw-bold">Nội dung câu hỏi (Question Stem) <span class="text-danger">*</span></label>
                        <input type="text" name="QuestionStem" class="form-control form-control-sm rounded-3" required
                               placeholder="VD: Ms. Carter _______ the quarterly financial report before the board meeting started." />
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Đáp án A</label>
                            <input type="text" name="OptionA" class="form-control form-control-sm rounded-3" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Đáp án B</label>
                            <input type="text" name="OptionB" class="form-control form-control-sm rounded-3" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Đáp án C</label>
                            <input type="text" name="OptionC" class="form-control form-control-sm rounded-3" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Đáp án D</label>
                            <input type="text" name="OptionD" class="form-control form-control-sm rounded-3" required />
                        </div>
                    </div>

                    <div class="row g-2">
                        <div class="col-md-3">
                            <label class="form-label small fw-bold text-success">Đáp án đúng</label>
                            <select name="CorrectOption" class="form-select form-select-sm rounded-3 fw-bold">
                                <option value="A">A</option>
                                <option value="B">B</option>
                                <option value="C">C</option>
                                <option value="D">D</option>
                            </select>
                        </div>
                        <div class="col-md-9">
                            <label class="form-label small fw-bold">Giải thích chi tiết</label>
                            <input type="text" name="ExplanationGeneral" class="form-control form-control-sm rounded-3" required />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top-0">
                    <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">
                        <i class="bi bi-check2-circle me-1"></i>Lưu &amp; Xuất bản Ngay
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function speakToeicTranscript(btn) {
            const text = btn.getAttribute('data-transcript');
            if (!text || !('speechSynthesis' in window)) {
                alert('Trình duyệt không hỗ trợ đọc giọng nói trực tiếp.');
                return;
            }
            window.speechSynthesis.cancel();
            const utter = new SpeechSynthesisUtterance(text);
            utter.lang = 'en-US';
            utter.rate = 0.95;
            window.speechSynthesis.speak(utter);
        }

        function filterQuestionBankCards() {
            const status = document.getElementById('qbFilterStatus').value;
            const skill = document.getElementById('qbFilterSkill').value;
            const q = (document.getElementById('qbSearchInput').value || '').toLowerCase().trim();

            document.querySelectorAll('.qb-group-card').forEach(card => {
                const cStatus = card.getAttribute('data-status') || '';
                const cSkill = card.getAttribute('data-skill') || '';
                const cSearch = card.getAttribute('data-search') || '';

                const matchStatus = !status || cStatus === status;
                const matchSkill = !skill || cSkill === skill;
                const matchSearch = !q || cSearch.includes(q);

                card.style.display = (matchStatus && matchSkill && matchSearch) ? '' : 'none';
            });
        }
    </script>
}
