@model ToeicCoachAI.Model.DTOs.Dashboard.StudentDashboardSummaryDto
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Bảng điều khiển học viên";
    ViewData["ActiveNav"] = "Home";

    var progressRatio = Model.TotalTargetLR > 0
        ? Math.Min(100, Math.Round((double)Model.TotalEstimatedLR / Model.TotalTargetLR * 100, 0))
        : 65;
    int hours = Model.WeeklyStudyMinutes / 60;
    int mins = Model.WeeklyStudyMinutes % 60;
}

<!-- Header Greeting -->
<div class="d-flex flex-wrap justify-content-between align-items-end mb-3">
    <div>
        <h2 class="fw-extrabold mb-1" style="font-size: 1.85rem; letter-spacing: -0.02em;">
            Chào buổi chiều, @Model.FirstName!
        </h2>
        <p class="text-muted mb-0" style="font-size: 0.92rem;">
            Hôm nay bạn chỉ cần 20 phút luyện tập thích ứng để tiến gần hơn đến mốc <strong>@Model.TotalTargetLR L&amp;R</strong> &amp; <strong>@Model.TargetWriting Writing</strong>.
        </p>
    </div>
    <div class="text-muted small fw-semibold mt-2 mt-md-0">
        <i class="bi bi-calendar3 me-1"></i>@DateTime.Now.ToString("dddd, dd/MM/yyyy", new System.Globalization.CultureInfo("vi-VN"))
    </div>
</div>

<!-- Hero Card: AI Priority Lesson Today -->
<div class="tc-db-hero-card mb-4">
    <div class="row align-items-center g-4">
        <div class="col-lg-8">
            <div class="d-flex align-items-start gap-3">
                <div class="tc-db-stat-icon bg-white shadow-sm text-primary">
                    <i class="bi bi-file-earmark-text"></i>
                </div>
                <div class="flex-grow-1">
                    <div class="fw-bold text-dark mb-1" style="font-size: 1.05rem;">
                        Bài học AI ưu tiên hôm nay
                    </div>
                    <span class="tc-db-hero-badge mb-2">
                        <i class="bi bi-stars"></i> Ưu tiên theo điểm yếu của bạn (UserSkillProficiency)
                    </span>
                    <h3 class="fw-extrabold text-dark mt-1 mb-2" style="font-size: 1.5rem;">
                        @Model.PriorityRecommendation.Title
                    </h3>
                    <div class="d-flex flex-wrap align-items-center gap-3 text-muted small mb-3">
                        <span><i class="bi bi-clock me-1"></i>@Model.PriorityRecommendation.QuestionCount câu hỏi thích ứng</span>
                        <span>•</span>
                        <span>Khoảng @Model.PriorityRecommendation.EstimatedMinutes phút</span>
                        <span>•</span>
                        <span class="text-primary fw-semibold">Thành thạo hiện tại: @Model.PriorityRecommendation.CurrentMasteryPercent%</span>
                    </div>

                    <div class="d-flex align-items-center gap-3 mb-3" style="max-width: 380px;">
                        <div class="progress flex-grow-1" style="height: 8px; background: #DCE3FF; border-radius: 999px;">
                            <div class="progress-bar" role="progressbar"
                                 style="width: @(Model.PriorityRecommendation.CurrentMasteryPercent)%; background: var(--db-primary); border-radius: 999px;"></div>
                        </div>
                        <span class="small fw-bold text-muted">@Model.PriorityRecommendation.CurrentMasteryPercent%</span>
                    </div>

                    <div class="d-flex flex-wrap align-items-center gap-3">
                        <a asp-controller="Dashboard" asp-action="Practice" class="tc-db-btn-primary">
                            Học ngay <i class="bi bi-arrow-right"></i>
                        </a>
                        <a asp-controller="Dashboard" asp-action="Progress" class="text-decoration-underline fw-bold small" style="color: var(--db-primary);">
                            Xem lộ trình &amp; Báo cáo AI
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4 d-none d-lg-flex justify-content-center">
            <!-- Target Bullseye SVG Illustration (Matches Screenshot 1) -->
            <svg width="210" height="165" viewBox="0 0 210 165" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M20 155L68 85L108 125L152 65L198 155H20Z" fill="#DCE4FF" fill-opacity="0.65"/>
                <circle cx="118" cy="78" r="46" fill="#E0E7FF" stroke="#C7D2FE" stroke-width="2"/>
                <circle cx="118" cy="78" r="30" fill="#FFFFFF" stroke="#A5B4FC" stroke-width="2"/>
                <circle cx="118" cy="78" r="14" fill="#6366F1"/>
                <path d="M118 78L174 22M174 22H154M174 22V42" stroke="#1E3A8A" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </div>
    </div>
</div>

<!-- 3 KPI Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="tc-db-card d-flex align-items-center gap-3">
            <div class="tc-db-stat-icon" style="background: #ECFDF5; color: #059669;">
                <i class="bi bi-bar-chart-line-fill"></i>
            </div>
            <div>
                <div class="text-muted small fw-semibold">Điểm ước tính (L&amp;R)</div>
                <div class="d-flex align-items-baseline gap-2">
                    <span class="tc-db-stat-value">@Model.TotalEstimatedLR</span>
                    <span class="badge rounded-pill bg-light text-dark border small">Writing: @Model.EstimatedWriting/200</span>
                </div>
                <div class="small fw-bold mt-1" style="color: #059669;">
                    <i class="bi bi-graph-up-arrow me-1"></i>+@Model.ScoreDeltaFromLastWeek điểm so với tuần trước
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="tc-db-card d-flex align-items-center gap-3">
            <div class="tc-db-stat-icon" style="background: #FFFBEB; color: #D97706;">
                <i class="bi bi-bullseye"></i>
            </div>
            <div class="flex-grow-1">
                <div class="text-muted small fw-semibold">Mục tiêu cá nhân</div>
                <div class="d-flex align-items-baseline justify-content-between">
                    <span class="tc-db-stat-value">@Model.TotalTargetLR</span>
                    <span class="small text-muted fw-semibold">Writing: @Model.TargetWriting</span>
                </div>
                <div class="small fw-semibold text-muted mt-1 mb-1">
                    <span class="text-warning me-1">●</span>Còn @Model.RemainingScoreGap điểm nữa chạm đích
                </div>
                <div class="progress" style="height: 6px; background: #E5E7EB; border-radius: 999px;">
                    <div class="progress-bar bg-success" style="width: @(progressRatio)%; border-radius: 999px;"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="tc-db-card d-flex align-items-center gap-3">
            <div class="tc-db-stat-icon" style="background: #EEF2FF; color: #3B5BDB;">
                <i class="bi bi-clock-history"></i>
            </div>
            <div>
                <div class="text-muted small fw-semibold">Thời gian học &amp; Sổ tay lỗi</div>
                <div class="tc-db-stat-value" style="font-size: 1.75rem;">@hours giờ @mins phút</div>
                <div class="small text-muted mt-1">
                    Tuần này • <a asp-controller="Dashboard" asp-action="Vocabulary" class="text-danger fw-bold text-decoration-none">@Model.ActiveMistakeCount lỗi sai cần ôn</a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bottom 3 Columns: Score Trajectory Chart + Priority Weak Skills + Weekly Plan -->
<div class="row g-3">
    <!-- Column 1: Score Trajectory Chart -->
    <div class="col-lg-5">
        <div class="tc-db-card">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                <h6 class="fw-bold mb-0">Khoảng cách đến mục tiêu</h6>
                <div class="d-flex gap-1">
                    <span class="tc-db-filter-pill active py-1 px-2" style="font-size: 0.75rem;">4 tuần</span>
                    <span class="tc-db-filter-pill py-1 px-2" style="font-size: 0.75rem;">8 tuần</span>
                    <span class="tc-db-filter-pill py-1 px-2" style="font-size: 0.75rem;">Tất cả</span>
                </div>
            </div>

            <!-- SVG Trajectory Chart (Matches Screenshot 1 & 5) -->
            <div class="mt-2">
                <svg viewBox="0 0 420 220" width="100%" height="215" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                        <linearGradient id="scoreAreaGrad" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="0%" stop-color="#4F46E5" stop-opacity="0.22"/>
                            <stop offset="100%" stop-color="#4F46E5" stop-opacity="0.0"/>
                        </linearGradient>
                    </defs>

                    <!-- Grid lines -->
                    <line x1="40" y1="30" x2="400" y2="30" stroke="#F1F5F9" stroke-width="1"/>
                    <line x1="40" y1="75" x2="400" y2="75" stroke="#F59E0B" stroke-width="1.5" stroke-dasharray="4 4"/>
                    <line x1="40" y1="125" x2="400" y2="125" stroke="#F1F5F9" stroke-width="1"/>
                    <line x1="40" y1="175" x2="400" y2="175" stroke="#F1F5F9" stroke-width="1"/>

                    <!-- Y Axis labels -->
                    <text x="10" y="34" fill="#9CA3AF" font-size="11">900</text>
                    <text x="10" y="79" fill="#9CA3AF" font-size="11">@Model.TotalTargetLR</text>
                    <text x="10" y="129" fill="#9CA3AF" font-size="11">600</text>
                    <text x="10" y="179" fill="#9CA3AF" font-size="11">450</text>

                    <!-- Area under actual curve -->
                    <path d="M55 150 L115 138 L175 130 L235 115 L235 190 L55 190 Z" fill="url(#scoreAreaGrad)"/>

                    <!-- Actual score solid line -->
                    <path d="M55 150 L115 138 L175 130 L235 115" fill="none" stroke="#0EA5E9" stroke-width="3"/>

                    <!-- Projected dashed line to target -->
                    <path d="M235 115 L310 95 L385 75" fill="none" stroke="#4F46E5" stroke-width="2.5" stroke-dasharray="6 4"/>

                    <!-- Points -->
                    <circle cx="55" cy="150" r="5" fill="#10B981"/>
                    <circle cx="115" cy="138" r="4.5" fill="#FFFFFF" stroke="#0EA5E9" stroke-width="2.5"/>
                    <circle cx="175" cy="130" r="4.5" fill="#FFFFFF" stroke="#0EA5E9" stroke-width="2.5"/>
                    <circle cx="235" cy="115" r="5.5" fill="#4F46E5"/>
                    <circle cx="385" cy="75" r="4.5" fill="#F59E0B"/>

                    <!-- Callout Badges -->
                    <rect x="40" y="122" width="38" height="20" rx="6" fill="#10B981"/>
                    <text x="59" y="136" fill="#FFFFFF" font-size="10" font-weight="bold" text-anchor="middle">520</text>

                    <rect x="195" y="86" width="80" height="22" rx="6" fill="#4F46E5"/>
                    <text x="235" y="101" fill="#FFFFFF" font-size="10" font-weight="bold" text-anchor="middle">Hiện tại @Model.TotalEstimatedLR</text>

                    <rect x="315" y="46" width="82" height="22" rx="6" fill="#FEF3C7"/>
                    <text x="356" y="61" fill="#B45309" font-size="10" font-weight="bold" text-anchor="middle">Mục tiêu @Model.TotalTargetLR</text>
                </svg>
            </div>
        </div>
    </div>

    <!-- Column 2: Weak Skill Tags Priority List (UserSkillProficiency) -->
    <div class="col-lg-4">
        <div class="tc-db-card">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h6 class="fw-bold mb-0">
                    <i class="bi bi-bar-chart-steps text-primary me-1"></i>Nội dung cần ưu tiên
                </h6>
                <a asp-controller="Dashboard" asp-action="Practice" class="small text-decoration-none fw-semibold">Luyện ngay</a>
            </div>

            <div class="d-flex flex-column gap-3">
                @for (int i = 0; i < Model.WeakSkillTags.Count; i++)
                {
                    var item = Model.WeakSkillTags[i];
                    var isCritical = item.MasteryPercent < 50;
                    var barColor = isCritical ? "#EF4444" : "#3B5BDB";
                    var badgeBg = isCritical ? "#FEF2F2" : "#EEF2FF";
                    var badgeColor = isCritical ? "#DC2626" : "#3B5BDB";

                    <div class="d-flex align-items-start gap-3">
                        <span class="rounded-circle d-inline-flex align-items-center justify-content-center fw-bold small flex-shrink-0 mt-1"
                              style="width: 26px; height: 26px; background: @badgeBg; color: @badgeColor;">
                            @(i + 1)
                        </span>
                        <div class="flex-grow-1">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="fw-bold small text-dark">@item.Name</span>
                                <span class="small fw-bold" style="color: @barColor;">@item.MasteryPercent%</span>
                            </div>
                            <div class="progress mb-1" style="height: 6px; background: #F1F5F9; border-radius: 999px;">
                                <div class="progress-bar" style="width: @(item.MasteryPercent)%; background: @barColor; border-radius: 999px;"></div>
                            </div>
                            <div class="text-muted" style="font-size: 0.78rem;">@item.Subtitle</div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Column 3: Weekly Schedule & Daily Action Plan -->
    <div class="col-lg-3">
        <div class="tc-db-card">
            <h6 class="fw-bold mb-3">
                <i class="bi bi-calendar2-check text-primary me-1"></i>Kế hoạch tuần này
            </h6>

            <div class="d-flex justify-content-between text-center mb-2">
                <div>
                    <div class="text-muted mb-1" style="font-size: 0.72rem;">T2</div>
                    <span class="tc-day-circle done"><i class="bi bi-check-lg"></i></span>
                </div>
                <div>
                    <div class="text-muted mb-1" style="font-size: 0.72rem;">T3</div>
                    <span class="tc-day-circle done"><i class="bi bi-check-lg"></i></span>
                </div>
                <div>
                    <div class="text-muted mb-1" style="font-size: 0.72rem;">T4</div>
                    <span class="tc-day-circle done"><i class="bi bi-check-lg"></i></span>
                </div>
                <div>
                    <div class="text-muted mb-1" style="font-size: 0.72rem;">T5</div>
                    <span class="tc-day-circle today"><i class="bi bi-dash"></i></span>
                </div>
                <div>
                    <div class="text-muted mb-1" style="font-size: 0.72rem;">T6</div>
                    <span class="tc-day-circle upcoming"></span>
                </div>
                <div>
                    <div class="text-muted mb-1" style="font-size: 0.72rem;">T7</div>
                    <span class="tc-day-circle upcoming"></span>
                </div>
                <div>
                    <div class="text-muted mb-1" style="font-size: 0.72rem;">CN</div>
                    <span class="tc-day-circle upcoming"></span>
                </div>
            </div>

            <div class="small mb-3">
                <strong class="text-success">3/5</strong> <span class="text-muted">buổi đã hoàn thành</span>
            </div>

            <div class="fw-bold small text-dark mb-2">Kế hoạch học hôm nay</div>
            <div class="d-flex flex-column gap-2">
                @foreach (var task in Model.TodayTasks)
                {
                    <a href="@task.ActionUrl" class="d-flex align-items-center justify-content-between p-2 rounded-3 border text-decoration-none text-dark bg-light bg-opacity-50">
                        <div class="d-flex align-items-center gap-2 small fw-medium text-truncate">
                            <input type="checkbox" class="form-check-input mt-0" @(task.IsCompleted ? "checked" : "") onclick="event.stopPropagation();" />
                            <span class="text-truncate">@task.Title</span>
                        </div>
                        <span class="text-muted flex-shrink-0 ms-2" style="font-size: 0.75rem;">
                            @task.DurationText <i class="bi bi-arrow-right ms-1"></i>
                        </span>
                    </a>
                }
            </div>
        </div>
    </div>
</div>

<!-- Paid User Exclusive Section: AI Competency Diagnosis & Adaptive 3-Skill Roadmap (UC-11) -->
<div class="tc-db-card mt-4" style="border: 1.5px solid @(Model.IsPaidTier ? "#C7D2FE" : "#E5E7EB"); background: @(Model.IsPaidTier ? "linear-gradient(135deg, #FFFFFF 0%, #F5F7FF 100%)" : "#FFFFFF");">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div class="d-flex align-items-center gap-2">
            <span class="tc-db-stat-icon" style="width: 38px; height: 38px; background: @(Model.IsPaidTier ? "#FEF3C7" : "#F3F4F6"); color: @(Model.IsPaidTier ? "#D97706" : "#6B7280");">
                <i class="bi @(Model.IsPaidTier ? "bi-award-fill" : "bi-lock-fill")"></i>
            </span>
            <div>
                <div class="d-flex align-items-center gap-2">
                    <h6 class="fw-bold mb-0">Lộ trình Cá nhân hóa &amp; Chẩn đoán AI 3 Kỹ năng (`AiCompetencyReport` - UC-11)</h6>
                    @if (Model.IsPaidTier)
                    {
                        <span class="badge rounded-pill bg-warning text-dark" style="font-size: 0.7rem;">👑 ĐÃ MỞ KHÓA PRO</span>
                    }
                    else
                    {
                        <span class="badge rounded-pill bg-secondary" style="font-size: 0.7rem;">🔒 TÍNH NĂNG GÓI TRẢ PHÍ (PAID)</span>
                    }
                </div>
                <div class="text-muted" style="font-size: 0.8rem;">
                    @Model.SubscriptionPlanName • Hạn mức phân tích AI hôm nay: <strong>@Model.DailyAnalysisUsed/@Model.DailyAnalysisLimit lượt</strong>
                </div>
            </div>
        </div>

        @if (Model.IsPaidTier)
        {
            <a asp-controller="Dashboard" asp-action="Progress" class="tc-db-btn-primary">
                <i class="bi bi-robot"></i> Xem Báo cáo AI Chuyên sâu
            </a>
        }
        else
        {
            <a asp-controller="Dashboard" asp-action="Subscription" class="tc-db-btn-primary">
                <i class="bi bi-stars"></i> Nâng cấp gói PRO
            </a>
        }
    </div>

    @if (Model.IsPaidTier)
    {
        <div class="row g-3">
            @for (int i = 0; i < Model.SuggestedRoadmapSteps.Count; i++)
            {
                <div class="col-md-4">
                    <div class="p-3 rounded-4 border bg-white h-100">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge rounded-pill" style="background: #EEF2FF; color: #3B5BDB;">Chặng @(i + 1)</span>
                            <span class="small text-success fw-bold"><i class="bi bi-check2-all me-1"></i>Adaptive AI</span>
                        </div>
                        <p class="small text-dark fw-medium mb-0" style="line-height: 1.5;">
                            @Model.SuggestedRoadmapSteps[i]
                        </p>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="p-3 rounded-4 border bg-light text-center">
            <p class="small text-muted mb-0">
                <i class="bi bi-info-circle me-1"></i>Tài khoản <strong>FREE</strong> chỉ hiển thị gợi ý bài học đơn lẻ. Nâng cấp lên <strong>PAID (PRO Coaching)</strong> để mở khóa <strong>Lộ trình 3 chặng cá nhân hóa (`SuggestedRoadmap`)</strong>, <strong>Thi thử Full 200 câu (`FULL_MOCK_LR`)</strong>, và <strong>Hạn mức 50 lượt AI giải thích sâu mỗi ngày</strong>.
            </p>
        </div>
    }
</div>
