@model ToeicCoachAI.Model.DTOs.Auth.RegisterRequestDto
@{
    ViewData["Title"] = "Đăng ký tài khoản miễn phí";
}

<section class="tc-hero-section py-5">
    <div class="container py-3">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-5">
                <div class="tc-dashboard-card p-4 p-md-5">
                    <div class="text-center mb-4">
                        <span class="tc-eyebrow">BẮT ĐẦU HÀNH TRÌNH TOEIC</span>
                        <h1 class="fs-3 fw-bold mb-1">Tạo tài khoản miễn phí</h1>
                        <p class="text-tc-secondary mb-0" style="font-size: 0.9rem;">
                            Lưu kết quả kiểm tra trình độ và mở khóa lộ trình học cá nhân hóa
                        </p>
                    </div>

                    @if (TempData["AuthError"] != null)
                    {
                        <div class="alert alert-danger py-2 px-3 mb-3" style="font-size: 0.88rem;">
                            <i class="bi bi-exclamation-circle-fill me-1"></i>
                            @TempData["AuthError"]
                        </div>
                    }

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 mb-3" style="font-size: 0.88rem;"></div>
                    }

                    <!-- Google OAuth Form -->
                    <form asp-controller="Auth" asp-action="GoogleLogin" method="post" class="mb-3">
                        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                        <button type="submit" class="btn btn-outline-secondary w-100 d-flex align-items-center justify-content-center gap-2 py-2 fw-semibold"
                                style="border-color: var(--tc-border); color: var(--tc-text-main); background: #fff;">
                            <svg width="18" height="18" viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
                                <path fill="#FFC107" d="M43.611,20.083H42V20H24v8h11.303c-1.649,4.657-6.08,8-11.303,8c-6.627,0-12-5.373-12-12c0-6.627,5.373-12,12-12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C12.955,4,4,12.955,4,24c0,11.045,8.955,20,20,20c11.045,0,20-8.955,20-20C44,22.659,43.862,21.35,43.611,20.083z"/>
                                <path fill="#FF3D00" d="M6.306,14.691l6.571,4.819C14.655,15.108,18.961,12,24,12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C16.318,4,9.656,8.337,6.306,14.691z"/>
                                <path fill="#4CAF50" d="M24,44c5.166,0,9.86-1.977,13.409-5.192l-6.19-5.238C29.211,35.091,26.715,36,24,36c-5.202,0-9.619-3.317-11.283-7.946l-6.522,5.025C9.505,39.556,16.227,44,24,44z"/>
                                <path fill="#1976D2" d="M43.611,20.083H42V20H24v8h11.303c-0.792,2.237-2.231,4.166-4.087,5.571c0.001-0.001,0.002-0.001,0.003-0.002l6.19,5.238C36.971,39.205,44,34,44,24C44,22.659,43.862,21.35,43.611,20.083z"/>
                            </svg>
                            <span>Đăng ký nhanh bằng Google</span>
                        </button>
                    </form>

                    <div class="d-flex align-items-center my-3">
                        <hr class="flex-grow-1 m-0" />
                        <span class="px-3 text-muted" style="font-size: 0.78rem;">HOẶC ĐĂNG KÝ BẰNG EMAIL</span>
                        <hr class="flex-grow-1 m-0" />
                    </div>

                    <form asp-controller="Auth" asp-action="Register" method="post">
                        <input type="hidden" asp-for="ReturnUrl" />

                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label fw-semibold" style="font-size: 0.88rem;">Họ và tên</label>
                            <input asp-for="FullName" class="form-control py-2" placeholder="Nguyễn Văn A" autocomplete="name" />
                            <span asp-validation-for="FullName" class="text-danger" style="font-size: 0.8rem;"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-semibold" style="font-size: 0.88rem;">Địa chỉ Email</label>
                            <input asp-for="Email" class="form-control py-2" placeholder="ban@email.com" autocomplete="email" />
                            <span asp-validation-for="Email" class="text-danger" style="font-size: 0.8rem;"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label fw-semibold" style="font-size: 0.88rem;">Mật khẩu</label>
                            <input asp-for="Password" class="form-control py-2" placeholder="Tối thiểu 6 ký tự" autocomplete="new-password" />
                            <span asp-validation-for="Password" class="text-danger" style="font-size: 0.8rem;"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold" style="font-size: 0.88rem;">Xác nhận mật khẩu</label>
                            <input asp-for="ConfirmPassword" class="form-control py-2" placeholder="Nhập lại mật khẩu" autocomplete="new-password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger" style="font-size: 0.8rem;"></span>
                        </div>

                        <button type="submit" class="btn btn-tc-primary w-100 py-2 mb-3">
                            Tạo tài khoản miễn phí
                        </button>

                        <div class="text-center text-secondary" style="font-size: 0.88rem;">
                            Đã có tài khoản?
                            <a asp-controller="Auth" asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl" class="text-tc-primary fw-semibold text-decoration-none">
                                Đăng nhập ngay
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
